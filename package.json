{
  "name": "aelpt",
  "version": "0.0.1",
  "private": true,
  "description": "AI Enhancement Learning Progress Tracker — Monorepo Root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npx rimraf apps/*/node_modules packages/*/node_modules node_modules apps/*/.next apps/*/dist"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "lint-staged": "^15.2.10",
    "husky": "^9.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
