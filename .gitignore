# ============================================================
# AELPT — Root .gitignore
# This file tells Git what to NEVER track.
# CRITICAL: .env and service account files must NEVER be committed.
# ============================================================

# ----------------------------------------
# SECURITY — NEVER COMMIT THESE (CRITICAL)
# ----------------------------------------
.env
.env.local
.env.production
.env.staging
*.pem
*-service-account.json
serviceAccountKey.json
firebase-adminsdk*.json

# ----------------------------------------
# NODE.JS
# ----------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
package-lock.json.bak

# ----------------------------------------
# NEXT.JS (apps/web)
# ----------------------------------------
apps/web/.next/
apps/web/out/
apps/web/build/
apps/web/.vercel/

# ----------------------------------------
# EXPRESS / NODE BUILD (apps/server)
# ----------------------------------------
apps/server/dist/
apps/server/build/

# ----------------------------------------
# TYPESCRIPT
# ----------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo

# ----------------------------------------
# TESTING
# ----------------------------------------
coverage/
.nyc_output/
*.lcov
vitest.cache/

# ----------------------------------------
# LOGS
# ----------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ----------------------------------------
# OPERATING SYSTEM
# ----------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ----------------------------------------
# EDITORS & IDEs
# ----------------------------------------

# VS Code (keep .vscode/settings.json if useful for team — but never extensions)
.vscode/extensions.json
.vscode/*.code-workspace

# JetBrains
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*.swn

# Emacs
*~
\#*\#

# ----------------------------------------
# HUSKY / LINT-STAGED
# ----------------------------------------
.husky/_/

# ----------------------------------------
# MISCELLANEOUS
# ----------------------------------------
.cache/
tmp/
temp/
*.tmp
*.bak
*.orig

# ----------------------------------------
# KEEP THESE (files that look like .gitignore entries but must be committed)
# ----------------------------------------
# .env.example      → ALWAYS commit (shows variable names without values)
# .gitkeep          → ALWAYS commit (tracks empty folders)
# PROJECT_CONSTITUTION.md → ALWAYS commit
# DEVELOPMENT_ROADMAP.md  → ALWAYS commit
